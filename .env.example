# Copy this file to .env.local and replace the placeholders.
# Never commit .env.local or put real secrets in this file.

# Public site origin. Production on Vercel: MI_SITE_URL=https://primordialt.com
# Local development can use either name. Vercel names are checked first.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# MI_SITE_URL=http://localhost:3000

# Better Auth base URL. Use the same origin as the site.
# Production on Vercel: MI_AUTH_URL=https://primordialt.com
BETTER_AUTH_URL=http://localhost:3000
# MI_AUTH_URL=http://localhost:3000

# Random signing secret, at least 32 characters.
# Production on Vercel: MI_AUTH_SECRET
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
# MI_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Neon pooled Postgres connection string.
# Production on Vercel: MI_DATABASE_URL
# In the Neon console: Project -> Connect -> Connection string -> Pooled.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# MI_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Used only by scripts/create-portal-user.ts. Set it in the shell for one command,
# not in this file with a real password. Unset it after the account is created.
# PORTAL_USER_PASSWORD=
# ALLOW_ADMIN_BOOTSTRAP=1
